# ==============================
# Moamenoon Cars - Environment Variables
# This file is OPTIONAL for local development.
# The app runs out of the box with zero config (embedded local MongoDB,
# a dev JWT secret, and a default admin login of admin@example.com /
# Admin@12345 created by `npm run seed`).
#
# Copy this file to ".env" only if you want to override any of that —
# e.g. to connect to your own MongoDB/Atlas, or before deploying anywhere
# real (you MUST set a real JWT_SECRET in production).
# ==============================

# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5000

# MongoDB — leave empty/unset to auto-start a local embedded database
MONGO_URI=

# JWT — required in production, optional locally (an insecure dev default is used)
JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRES_IN=30d
JWT_COOKIE_EXPIRES_IN=30

# Uploads
MAX_FILE_UPLOAD_MB=5
UPLOAD_PATH=./uploads

# Admin bootstrap (used only by the `npm run seed` script)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=200

# NOTE: the actual runtime copy used by the server lives at server/.env
# (copy server/.env.example -> server/.env and edit the values there, if you want to override anything).
