# Copy this file to ".env" and fill it in. Never share or commit ".env".
# To run it on your laptop you only need ADMIN_PASSWORD. Everything else is optional.

# --- Owner (admin) account ---
ADMIN_EMAIL=moamnoon.co@gmail.com
# Choose a password (8+ chars). Changing it here and restarting also resets the admin password.
ADMIN_PASSWORD=

# --- Email (Gmail) - optional on your laptop, needed on the real server ---
# Without SMTP_PASS, emails are printed in the terminal instead of being sent.
# Emails are sent FROM SMTP_USER. Create an "App password" for it:
# Google Account > Security > 2-Step Verification (turn on) > App passwords
SMTP_USER=moamnoon.co@gmail.com
SMTP_PASS=

# ============ Only on the REAL host (leave commented on your laptop) ============
# NODE_ENV=production
# SITE_URL=https://your-domain.com
# Where the database and photos are stored. Point it to a PERSISTENT disk/volume.
# DATA_DIR=/var/data
# PORT=3000
# A long random string used to sign login cookies (auto-generated into DATA_DIR if empty)
# SESSION_SECRET=
# How many proxies are in front of the app: 1 = nginx only, 2 = Cloudflare (orange cloud) + nginx.
# Needed so login limits / rate limits see the REAL visitor IP.
# TRUST_PROXY=1

# --- Advanced (the defaults are fine) ---
# WEB_CONCURRENCY=2            number of app copies pm2 runs (= number of CPU cores)
# MICROCACHE_MS=10000          how long public car lists are served from memory (0 = off)
# API_RATE_LIMIT=600           API requests per minute per visitor IP
# MAX_CONCURRENT_UPLOADS=4     photo uploads processed at the same time (others wait in a queue)
# MAX_CARS_PER_DEALER=300      cars one dealer account may add
